# --- Server ---
PORT=8787
# Where SQLite files live (study.db = real data, demo.db = sample data; never shared)
DATA_DIR=./data

# --- AI provider (server-side only; never exposed to the browser) ---
# Leave ANTHROPIC_API_KEY empty to run in Offline mode (basic template questions, uncertain grading).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Per-call timeout and daily call cap (cost control)
AI_TIMEOUT_MS=45000
AI_DAILY_CALL_LIMIT=150

# --- Google Calendar (optional, read-only) ---
# Create an OAuth "Web application" client in Google Cloud Console and enable the Calendar API.
# Authorized redirect URI must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/calendar/oauth/callback
# Required to store Google tokens: any long random string (used to encrypt tokens at rest).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
