# ============================================================================
# Study Helper configuration. Copy to .env (never commit .env). Run `npm run doctor` to check it.
# Secrets stay on the server: they are never sent to the browser or written to logs.
# ============================================================================

# --- Server ---------------------------------------------------------------
PORT=8787
HOST=127.0.0.1            # local mode has NO login and refuses any other HOST. Hosted mode (APP_MODE=hosted, below) has sign-in and binds 0.0.0.0 on the host's PORT.
DATA_DIR=./data           # study.db = your data, demo.db = sample data (separate files)

# --- AI: Anthropic (default provider) --------------------------------------
# Leave the key empty to run in Offline mode (math fully; other subjects basic templates).
ANTHROPIC_API_KEY=
# Default model for every task. Verified against Anthropic's models page on 2026-10-26:
#   claude-sonnet-5-5  (quality baseline, $2/$10 per MTok)    claude-haiku-5-5  ($0.10/$0.50 per MTok, cheaper/faster)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional per-task overrides. Route a task to Haiku ONLY after `npm run eval:live` shows it holds up for you.
# AI_MODEL_EXTRACT=claude-haiku-5-5
# AI_MODEL_GENERATE=
# AI_MODEL_GRADE=
# Output ceilings (tokens; thinking counts toward these) and effort (low|medium|high). Defaults are untuned.
# AI_MAX_OUTPUT_EXTRACT=4000
# AI_MAX_OUTPUT_GENERATE=5000
# AI_MAX_OUTPUT_GRADE=1500
# AI_EFFORT_EXTRACT=low
# AI_EFFORT_GENERATE=medium
# AI_EFFORT_GRADE=medium
# Cost controls: a conservative reservation is held before every request (retries included) and reconciled with reported usage. A guardrail, not a guaranteed ceiling —
# your provider's billing is authoritative. Rolling 24 hours. 0 disables paid AI.
AI_DAILY_BUDGET_USD=1.00
AI_DAILY_CALL_LIMIT=150
AI_TIMEOUT_MS=45000
# Only needed for a model that is not in the built-in price table:
# AI_PRICE_IN_PER_MTOK=
# AI_PRICE_OUT_PER_MTOK=
# Optional proxy/mock endpoint (https, or http on localhost only):
# ANTHROPIC_BASE_URL=

# --- AI: Groq (optional, OPT-IN, not verified live) -------------------------
# Never used unless AI_PROVIDER=groq. Just the key: the model is built in (no model choice).
# Student material goes to Groq instead of Anthropic while this is on; screenshot reading needs Anthropic.
# AI_PROVIDER=groq
# GROQ_API_KEY=

# --- Google Calendar (optional, read-only) ----------------------------------
# See docs/GOOGLE_SETUP.md. Only the calendar.readonly scope is requested.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in Google Cloud Console EXACTLY (scheme, host, port, path).
GOOGLE_REDIRECT_URI=http://localhost:8787/api/calendar/oauth/callback
# Required to store Google tokens (encrypted at rest). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# --- Reading scans and screenshots (optional, OFF by default) -----------------
# Sends page images / PDF pages to ANTHROPIC to be transcribed. You see the provider, model, exact pages and worst-case cost and must approve each time.
# Needs ANTHROPIC_API_KEY. Counts in the daily budget. Leave empty to keep everything local (type scanned pages by hand instead).
AI_OCR=
# AI_MODEL_OCR=claude-haiku-5-5      # optional; unmeasured for reading quality, so the default is your main model
# AI_MAX_OUTPUT_OCR=6000

# ---- Hosted school pilot (APP_MODE=hosted). Set these in the host's secret store, never in git. ----
# APP_MODE=hosted
# APP_ENV=staging            # or production; must match DATA_LABEL
# DATA_LABEL=staging
# DATABASE_URL=              # PostgreSQL
# PUBLIC_URL=https://...     # the site's own address (https in production)
# BETTER_AUTH_SECRET=        # random, 32+ chars
# APP_SECRET=                # random; per-student Calendar tokens are derived from it
# OPERATOR_TOKEN=            # bearer for /internal/metrics
# OPERATOR_NAME= / OPERATOR_CONTACT=   # required in production (shown in the privacy notice)
# AUTH_OIDC_* / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET   # sign-in with Google
# AUTH_PASSWORD=1            # staging only
# LIMIT_USER_DAILY_AI_REQUESTS / LIMIT_USER_DAILY_USD / LIMIT_GLOBAL_DAILY_USD / LIMIT_GLOBAL_CONCURRENT_AI / LIMIT_USER_DAILY_UPLOADS ...
# CALENDAR_ENABLED=1         # hosted mode: Google Calendar is OFF unless this is 1 (signing in with Google never turns it on). Needs GOOGLE_CLIENT_ID/SECRET; redirect defaults to PUBLIC_URL + /api/calendar/oauth/callback
# RENDER_EXTERNAL_URL        # set by Render; used as PUBLIC_URL when PUBLIC_URL is empty
# INSTANCE_LOCK_WAIT_MS=30000   # how long a new process waits for the previous one to release the database before refusing to start
