{
  "name": "study-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven AI study coach: sources -> concepts -> diagnostic -> practice -> spaced review.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "eval": "tsx src/eval/cli.ts",
    "eval:live": "tsx src/eval/cli.ts --live",
    "smoke:ai": "tsx src/eval/smoke.ts",
    "doctor": "tsx src/server/doctor.ts",
    "operator": "tsx src/server/ops/cli.ts",
    "test:e2e": "npm run build && playwright test",
    "build:server": "node scripts/build-server.mjs",
    "build:hosted": "npm run build && npm run build:server",
    "start:hosted": "APP_MODE=hosted NODE_ENV=production node dist-server/main.mjs",
    "operator:prod": "node dist-server/operator.mjs",
    "prune:prod": "node scripts/prune-dev-only.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "test:hosted": "REQUIRE_PG=1 vitest run tests/hosted",
    "loadtest": "tsx scripts/loadtest.ts",
    "rehearse:prod": "tsx scripts/rehearse-production.ts",
    "seed:staging": "tsx scripts/seed-staging.ts",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "express": "^4.21.2",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
