{
  "name": "study-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven AI study coach: sources -> concepts -> diagnostic -> practice -> spaced review.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "eval": "tsx src/eval/cli.ts",
    "eval:live": "tsx src/eval/cli.ts --live",
    "smoke:ai": "tsx src/eval/smoke.ts",
    "doctor": "tsx src/server/doctor.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
