import { rmSync } from 'node:fs';
import { createApp } from './src/server/app';
import { configFromEnv } from './src/server/config';
import { createRuntime } from './src/server/context';
const dir = process.env.WALK_DIR!; if (process.env.WALK_FRESH === '1') rmSync(dir, { recursive: true, force: true });
let offset = 0;
const cfg = { ...configFromEnv({ ...process.env, ANTHROPIC_API_KEY: process.env.WALK_KEY ?? '' } as any), dataDir: dir };
const rt = createRuntime(cfg, { now: () => Date.now() + offset, dir });
const app = createApp(rt);
app.post('/__clock', (req, res) => { offset += Number(req.query.hours ?? 0) * 3600_000; res.json({ offset }); });
app.listen(Number(process.env.PORT), '127.0.0.1', () => console.log('walk server up'));
